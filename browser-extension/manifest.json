{
  "manifest_version": 3,
  "name": "__MSG_helperName__",
  "version": "1.0.0.1080",
  "description": "__MSG_helperDescription__",
  "minimum_chrome_version": "128",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chathand-16.png",
      "32": "icons/chathand-32.png"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "version_name": "1.0.0-beta.30 (1080)",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/chathand-16.png",
    "32": "icons/chathand-32.png",
    "48": "icons/chathand-48.png",
    "128": "icons/chathand-128.png"
  }
}
