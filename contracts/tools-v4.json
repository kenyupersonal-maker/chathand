      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "auto",
            "text",
            "docx",
            "xlsx",
            "csv",
            "plist",
            "sqlite",
            "pdf",
            "image"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 131072
        },
        "encoding": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "parameters": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
